{
  "name": "dsh-tracescope",
  "private": true,
  "version": "0.1.4",
  "description": "TraceScope: git-diff impact scoping and test-trace analysis for DeepSeek Harness",
  "license": "MIT",
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @rebornace/tracescope-core test",
    "typecheck": "pnpm -r run typecheck",
    "publish:npm": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-npm.ps1"
  },
  "engines": {
    "node": ">=20"
  }
}
