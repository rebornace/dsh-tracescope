{
  "name": "dsh-tracescope",
  "private": true,
  "version": "0.3.6",
  "description": "TraceScope: git-diff impact scoping and design↔code visual diff for DeepSeek Harness",
  "license": "MIT",
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "node scripts/dev-desktop.mjs",
    "dev:link": "node scripts/dev-desktop.mjs link",
    "dev:unlink": "node scripts/dev-desktop.mjs unlink",
    "test": "pnpm --filter @rebornace/tracescope-core test",
    "typecheck": "pnpm -r run typecheck",
    "publish:npm": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-npm.ps1"
  },
  "engines": {
    "node": ">=20"
  }
}
