{
  "name": "@rebornace/dsh-tracescope",
  "version": "0.1.11",
  "description": "TraceScope DeepSeek Harness plugin 鈥?embedded React Slot UI + same-origin APIs",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./panel-server": {
      "types": "./dist/panel-server.d.ts",
      "default": "./dist/panel-server.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "panel",
    "client"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "external": []
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@rebornace/tracescope-core": "workspace:0.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-market",
    "deepseek-harness",
    "dsh",
    "dsh-web",
    "dsh-desktop",
    "dsh-tracescope",
    "tracescope",
    "testing",
    "manual-testing",
    "hand-test",
    "impact-analysis",
    "git-diff",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rebornace/dsh-tracescope.git",
    "directory": "packages/dsh-tracescope"
  },
  "homepage": "https://github.com/rebornace/dsh-tracescope#readme",
  "bugs": {
    "url": "https://github.com/rebornace/dsh-tracescope/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
